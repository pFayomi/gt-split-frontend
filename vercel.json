{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gt-split-backend.onrender.com/:path*"
    },
    {
      "source": "/pay/:path*",
      "destination": "https://gt-split-backend.onrender.com/pay/:path*"
    },
    {
      "source": "/auto-split/:path*",
      "destination": "https://gt-split-backend.onrender.com/auto-split/:path*"
    },
    {
      "source": "/((?!api/|pay/|auto-split/).*)",
      "destination": "/index.html"
    }
  ]
}
